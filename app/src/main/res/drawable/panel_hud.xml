<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2A00B3FF"
                android:centerColor="#1A0084FF"
                android:endColor="#14003D66"
                android:angle="270"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00101825"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#59EAF7FF"/>
        </shape>
    </item>
</layer-list>